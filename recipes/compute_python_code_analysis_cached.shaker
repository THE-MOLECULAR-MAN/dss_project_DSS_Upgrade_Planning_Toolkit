      "disabled": false,
      "type": "CreateColumnWithGREL",
      "params": {
        "expression": "min(est_py3_version,14)/14",
        "column": "py_3_version_scaled"
      },
      "alwaysShowComment": false
    },
    {
      "preview": false,
