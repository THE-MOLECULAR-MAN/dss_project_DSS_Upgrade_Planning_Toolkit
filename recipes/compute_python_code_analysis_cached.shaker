      "type": "CreateColumnWithGREL",
      "params": {
        "expression": "min(radon_cc_avg,30)/30",
        "column": "radon_cc_avg_scaled"
      },
      "alwaysShowComment": false
    },
    {
      "preview": false,
      "metaType": "PROCESSOR",
