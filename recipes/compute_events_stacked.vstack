{
  "mode": "REMAP",
  "selectedColumns": [
    "project_key",
    "start_time",
    "end_time",
    "state",
    "warnings_count",
    "scenario_id",
    "user"
  ],
  "originColumnName": "event_type",
  "engineParams": {
    "hive": {
      "skipPrerunValidate": false,
      "hiveconf": [],
      "inheritConf": "default",
      "addDkuUdf": false,
      "executionEngine": "HIVESERVER2"
    },
    "sqlPipelineParams": {
      "pipelineAllowMerge": true,
      "pipelineAllowStart": true
    },
    "impala": {
      "forceStreamMode": true
    },
    "lowerCaseSchemaIfEngineRequiresIt": true,
    "sparkSQL": {
      "skipPrerunValidate": false,
      "pipelineAllowMerge": true,
      "useGlobalMetastore": false,
      "pipelineAllowStart": true,
      "readParams": {
        "mode": "AUTO",
        "autoModeRepartitionInto": 10,
        "map": {}
      },
      "overwriteOutputSchema": false,
      "executionEngine": "SPARK_SUBMIT",
      "sparkConfig": {
        "inheritConf": "spark-k8s",
        "conf": []
      }
    }
  },
  "copySchemaFromDatasetWithName": "cluster_tasks",
  "virtualInputs": [
    {
      "preFilter": {
        "distinct": false,
        "enabled": false
      },
      "originLabel": "job",
      "index": 0,
      "columnsMatch": [
        "job_project_key",
        "time_start",
        "time_end",
        "state",
        "warnings_count",
        "scenario_id",
        "job_def_initiator"
      ]
    },
    {
      "preFilter": {
        "distinct": false,
        "enabled": false
      },
      "originLabel": "scenario",
      "index": 1,
      "columnsMatch": [
        "scenario_project_key",
        "time_start",
        "time_end",
        "outcome",
        "warnings_count",
        "scenario_id",
        "scenario_run_as_user"
      ]
    },
    {
      "preFilter": {
        "distinct": false,
        "enabled": false
      },
      "originLabel": "cluster_task",
      "index": 2,
      "columnsMatch": [
        "project_key",
        "start_time",
        "end_time",
        "",
        "",
        "",
        "user"
      ]
    }
  ],
  "postFilter": {
    "uiData": {
      "mode": "\u0026\u0026",
      "conditions": [
        {
          "date": "1970-01-01",
          "input": "end_time",
          "col": "project_key",
          "time2": "00:00",
          "unit": "days",
          "num": 0.0,
          "time": "00:00",
          "date2": "2026-01-04",
          "items": [
            {
              "date": "1970-01-01",
              "unit": "days",
              "num": 0.0,
              "time": "00:00"
            }
          ],
          "operator": "not empty string"
        }
      ]
    },
    "distinct": false,
    "enabled": false
  },
  "addOriginColumn": true
}